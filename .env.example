# LifeLink Twin - Environment Configuration Template

# Node Environment (production | development)
NODE_ENV=development

# Server Port
PORT=3000

# MQTT Broker URL
MQTT_BROKER=mqtt://localhost:1883

# Authentication Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
SESSION_SECRET=your-secure-session-secret-key-at-least-32-chars

# Dashboard URL (for CORS)
DASHBOARD_URL=http://localhost:5173
